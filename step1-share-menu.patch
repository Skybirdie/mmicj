+    function leaveForLibrary() {
+
+        setShareMenuOpen(false);
+
+        if (leavingForLibrary) {
+            return;
+        }
+
+        leavingForLibrary =
+            true;
+
+        libraryFallbackTimer =
+            window.setTimeout(
+                () => {
+
+                    libraryFallbackTimer =

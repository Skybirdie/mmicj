+/* =========================================================
+   SHARE PAGE APP SWITCHER MENU (opens upward)
+
+   Mirrors #frontMenuPanel on the Front Page (glass panel,
+   same row style) but is anchored above the bottom-right
+   button instead of below a top-right one. Both the scrim
+   and the panel live inside .sky-share-actions, so they
+   share its stacking layer (z-index 1000040) and, with the
+   scrim at z-index -1, sit behind the button itself.
+   ========================================================= */
+
+body.sky-share-mode .sky-share-menu-scrim {
+    position: fixed;
+    inset: 0;
+    z-index: -1;
+    display: none;
+    background: transparent;
+    -webkit-tap-highlight-color: transparent;
+}
+
+body.sky-share-mode .sky-share-menu-scrim.is-open {
+    display: block;
+}
+
+body.sky-share-mode .sky-share-menu-panel {
+    --sky-share-menu-text: #18202a;
+    --sky-share-menu-bg: rgba(255,255,255,.88);
+    --sky-share-menu-border: rgba(24,32,42,.22);
+    --sky-share-menu-shadow: 0 12px 34px rgba(0,0,0,.18);
+
+    position: fixed;
+    right: clamp(15px, 1.2vw, 25px);
+    bottom: calc(
+        clamp(35px, 4vw, 40px) +
+        clamp(42px, 5vw, 64px) +
+        8px
+    );
+    z-index: 2;
+
+    display: flex;
+    flex-direction: column;
+    gap: 7px;
+
+    min-width: 170px;
+    padding: 9px;
+    box-sizing: border-box;
+
+    border: 1px solid var(--sky-share-menu-border);
+    border-radius: 16px;
+    background: var(--sky-share-menu-bg);
+    color: var(--sky-share-menu-text);
+    box-shadow: var(--sky-share-menu-shadow);
+    backdrop-filter: blur(16px);
+    -webkit-backdrop-filter: blur(16px);
+
+    opacity: 0;
+    visibility: hidden;
+    transform: translateY(5px);
+    transition:
+        opacity .18s ease,
+        transform .18s ease,
+        visibility .18s ease;
+}
+
+html[data-theme="dark"] body.sky-share-mode .sky-share-menu-panel {
+    --sky-share-menu-text: #f4f7fa;
+    --sky-share-menu-bg: rgba(12,16,22,.86);
+    --sky-share-menu-border: rgba(244,247,250,.24);
+    --sky-share-menu-shadow: 0 14px 38px rgba(0,0,0,.48);
+}
+
+body.sky-share-mode .sky-share-menu-panel.is-open {
+    opacity: 1;
+    visibility: visible;
+    transform: translateY(0);
+}
+
+body.sky-share-mode .sky-share-menu-link {
+    display: flex;
+    align-items: center;
+    gap: 10px;
+
+    width: 100%;
+    min-height: 38px;
+    padding: 8px 11px;
+    box-sizing: border-box;
+
+    border: 1px solid transparent;
+    border-radius: 11px;
+    background: transparent;
+    color: inherit;
+
+    font: 600 13px/1 Inter, Arial, sans-serif;
+    text-decoration: none;
+    text-align: left;
+    white-space: nowrap;
+
+    cursor: pointer;
+    -webkit-tap-highlight-color: transparent;
+}
+
+body.sky-share-mode .sky-share-menu-link:hover,
+body.sky-share-mode .sky-share-menu-link:focus-visible {
+    background: color-mix(in srgb, var(--sky-share-menu-text) 9%, transparent);
+    border-color: color-mix(in srgb, var(--sky-share-menu-text) 14%, transparent);
+}
+
+body.sky-share-mode .sky-share-menu-link:focus-visible {
+    outline: 2px solid currentColor;
+    outline-offset: 1px;
+}
+
+body.sky-share-mode .sky-share-menu-link svg {
+    width: 20px;
+    height: 20px;
+    flex: 0 0 20px;
+    display: block;
+}
+
+@media (max-width: 700px) {
+    body.sky-share-mode .sky-share-menu-panel {
+        min-width: 158px;
+    }
+}
+
+@media (prefers-reduced-motion: reduce) {
+    body.sky-share-mode .sky-share-menu-panel {
+        transition: none;
+    }
+}

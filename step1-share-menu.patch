+            "pageshow",
+            event => {
+
+                if (!event.persisted) {
+                    return;
+                }
+
+                setShareMenuOpen(false);
+
+                if (leavingForLibrary) {
+                    window.location.reload();
+                }
+            }
+        );
+    }

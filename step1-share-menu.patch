+        if (!shareMenu) {
+            return;
+        }
+
+        const next =
+            !!open;
+
+        if (shareMenu.open === next) {
+            return;
+        }
+
+        shareMenu.open =
+            next;
+
+        shareMenu.button.setAttribute(
+            "aria-expanded",
+            next ? "true" : "false"

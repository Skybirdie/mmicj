+            "true"
+        );
+
+        const use =
+            document.createElementNS(
+                SVG_NS,
+                "use"
+            );
+
+        use.setAttribute(
+            "href",
+            "#" + symbolId
+        );
+
+        svg.appendChild(use);
+
+        return svg;
+    }
+
+
+    function setShareMenuOpen(open) {

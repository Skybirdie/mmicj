+
+function isShareModeEnabled(
+  env
+) {
+  const raw =
+    env &&
+    env.SHARE_MODE_ENABLED !== undefined &&
+    env.SHARE_MODE_ENABLED !== null
+      ? String(
+          env.SHARE_MODE_ENABLED
+        )
+          .trim()
+          .toLowerCase()
+      : "";
+
+  if (
+    [
+      "false",
+      "0",
+      "off",
+      "no"
+    ].includes(
+      raw
+    )
+  ) {
+    return false;
+  }
+
+  if (
+    [
+      "true",
+      "1",
+      "on",
+      "yes"
+    ].includes(
+      raw
+    )
+  ) {
+    return true;
+  }
+
+  return SHARE_MODE_ENABLED;
+}

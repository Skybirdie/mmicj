@@ -1340,4 +1340,88 @@
     min-width:32px;
     font-size:13px;
   }
-}
\ No newline at end of file
+}
+
+/* ---------------------------------------------------------
+   BookStack (js/bookStack.js) - optional page-edge stacks on the
+   outer sides of a two-page spread. Purely decorative: sits behind
+   the StPageFlip wrapper, never receives pointer events, and is
+   only created when the "Page edges" setting is on.
+--------------------------------------------------------- */
+
+.skyBookStack{
+position:absolute;
+inset:0;
+pointer-events:none;
+z-index:-1;
+--sky-stack-paper:#fdfbf6;
+--sky-stack-line:#a39a86;
+--sky-stack-time:300ms;
+}
+
+/* Single-page mode mounts in #viewerArea (no negative z-index there). */
+.skyBookStack.--in-viewer{
+z-index:0;
+}
+
+html[data-theme="dark"] .skyBookStack{
+--sky-stack-paper:#dcd7cb;
+--sky-stack-line:#8d8778;
+}
+
+.skyBookStackSide{
+position:absolute;
+box-sizing:border-box;
+opacity:0;
+pointer-events:none;
+}
+
+.skyBookStack.--animate .skyBookStackSide{
+transition:
+    left var(--sky-side-time,var(--sky-stack-time)) cubic-bezier(.22,.61,.36,1),
+    width var(--sky-side-time,var(--sky-stack-time)) cubic-bezier(.22,.61,.36,1),
+    opacity min(160ms,var(--sky-side-time,160ms)) linear;
+}
+
+/* Each side holds individual leaves (js/bookStack.js). The side itself
+   only supplies the silhouette shadow and the shading where it meets the page. */
+.skyBookStackSide{
+filter:drop-shadow(1px 1px 1.5px rgba(0,0,0,.32));
+}
+
+.skyBookStackLeaf{
+position:absolute;
+box-sizing:border-box;
+pointer-events:none;
+}
+
+.skyBookStackSide.--right .skyBookStackLeaf{
+box-shadow:inset -1px 0 0 var(--sky-stack-line);
+border-radius:0 1.5px 1.5px 0;
+}
+
+.skyBookStackSide.--left .skyBookStackLeaf{
+box-shadow:inset 1px 0 0 var(--sky-stack-line);
+border-radius:1.5px 0 0 1.5px;
+}
+
+.skyBookStackSide::after{
+content:"";
+position:absolute;
+inset:0;
+pointer-events:none;
+}
+
+.skyBookStackSide.--right::after{
+background:linear-gradient(to right,rgba(0,0,0,.34),rgba(0,0,0,0) 45%);
+}
+
+.skyBookStackSide.--left::after{
+background:linear-gradient(to left,rgba(0,0,0,.34),rgba(0,0,0,0) 45%);
+}
+
+@media (prefers-reduced-motion:reduce){
+.skyBookStack.--animate .skyBookStackSide{
+    transition:none;
+}
+}

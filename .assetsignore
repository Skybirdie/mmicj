# Files that must never be served to visitors as static assets.
# (assets.directory is "." in wrangler.jsonc, so anything not listed
# here is uploaded and publicly downloadable.)
.git
node_modules

# Worker source and deployment config
/worker.js
/worker.mjs
/wrangler.jsonc
/wrangler.toml
/package.json
/package-lock.json

# Tests, patches and notes
*.test.mjs
*.test.js
*.diff
*.md
*.zip
*.bak
*.bak-*
/README.txt

# Glide generator formulas (contain the publish token) and admin notes
/glide-generator*.txt
/admin/p1Glide.txt

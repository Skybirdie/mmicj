{
  "$schema": "./node_modules/wrangler/config-schema.json",

  "name": "mmicj",

  "main": "worker.js",

  "compatibility_date": "2026-09-19",

  /*
   * VARIABLES  (why usage counting silently stopped)
   *
   * `wrangler deploy` treats THIS file as the source of truth for plain-text
   * variables. A variable that exists only in the Cloudflare dashboard
   * (Settings -> Variables and Secrets) is DELETED by the next deploy.
   * ANALYTICS_ENABLED used to live only in the dashboard, so the first deploy
   * after it was set removed it; the Worker then answered {"on":false} to
   * every report, every app paused itself for 6 hours (and threw away its
   * counters), and no new data points were written.
   *
   * Fix 1: ANALYTICS_ENABLED is now written here, so every deploy keeps it.
   *        To switch counting off: change it to "false" and deploy
   *        (or edit it in the dashboard for an immediate stop - but note
   *        the next deploy puts this file's value back).
   *
   * Fix 2: keep_vars keeps any OTHER dashboard-only variable (for example
   *        MAINTENANCE or SHARE_MODE_ENABLED) through later deploys, so
   *        they cannot vanish the same way.
   *
   * Both cost nothing at runtime: no extra requests, no extra writes.
   */
  "keep_vars": true,
  "vars": {
    "ANALYTICS_ENABLED": "true"
  },

  /*
   * OBSERVABILITY
   *
   * invocation_logs: false
   *
   *   Cloudflare writes one automatic event for EVERY request
   *   that reaches the Worker, whether or not the Worker logs
   *   anything. That is what made observability events track
   *   request count almost exactly during troubleshooting.
   *
   *   With invocation_logs off, an event is written only when
   *   the Worker actually emits something - which, after the
   *   catalog-lookup log was removed, means console.error and
   *   console.warn only. Successful share views become silent.
   *
   * head_sampling_rate: 1
   *
   *   Kept at 100% deliberately. Sampling would throw away
   *   nine out of ten error traces, which is the opposite of
   *   what you want while the books and videos routes are
   *   still being built. Because only failures now produce
   *   events, full fidelity is cheap.
   *
   *   For live debugging use `npx wrangler tail` instead -
   *   it streams in real time and does not consume the
   *   observability events quota.
   */

  "observability": {
    "enabled": true,

    "logs": {
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },

  /*
   * ASSETS
   *
   * run_worker_first is NOT true. Requests that match a file
   * in this directory are served straight from Cloudflare's
   * asset layer and never invoke the Worker, so they are free
   * and unlimited. Setting it to true would route every
   * stylesheet, script, image and audio file through the
   * Worker and bill each one.
   *
   * Only these routes always run the Worker: "/" (the base URL, so the link-preview
   * tags can be added), "/s/*" (share links) and "/__sky_*" (the Worker's own
   * endpoints). Everything else is served from the asset layer, and an address that
   * matches no file gets 404.html without invoking the Worker. If you add a new
   * Worker route, add its path to run_worker_first as well.
   *
   * To switch the dynamic base preview off again, set this back
   * to false (the page then serves with no preview tags).
   */

    "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/s/*", "/__sky_*"]
  },

  "kv_namespaces": [
    {
      "binding": "MEDIA_KV",
      "id": "7c42947459a5469097506444ac39304f"
    }
  ],

  "images": {
    "binding": "IMAGES"
  },

  /*
   * ANALYTICS (admin-only usage counts)
   *
   * Workers Analytics Engine, free plan: 100,000 data points and
   * 10,000 read queries per day. The dataset is created automatically
   * on the first write.
   *
   * The ON/OFF SWITCH is the plain variable ANALYTICS_ENABLED, set in
   * "vars" at the top of this file (a dashboard-only value is wiped by
   * the next deploy).
   * Missing or anything other than true/on/1/yes means OFF.
   */
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS_AE", "dataset": "mmicj_events" }
  ]
}
